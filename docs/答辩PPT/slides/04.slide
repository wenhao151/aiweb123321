<Slide style={{ width: 1280, height: 720, padding: 0, background: '#FFFFFF', fontFamily: 'Source Han Sans SC, Microsoft YaHei, Arial, sans-serif' }}>
  <Box style={{ width: 1280, height: 68, background: '#1E4FA8', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 60, paddingRight: 60 }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#FFFFFF' }}>四层架构，检索与教学解耦</Text>
    <Text style={{ fontSize: 16, color: '#C9DBF5' }}>03 · ARCHITECTURE</Text>
  </Box>
  <Box style={{ width: 1280, height: 1, background: '#D6DCE5' }} />
  <Box style={{ width: 1280, height: 581, paddingLeft: 60, paddingRight: 60, paddingTop: 24, paddingBottom: 18, flexDirection: 'column', gap: 14 }}>
    <Box style={{ width: 1160, height: 66, flexDirection: 'row', border: '1px solid #3D7BD9' }}>
      <Box style={{ width: 190, background: '#1E4FA8', alignItems: 'center', justifyContent: 'center' }}><Text style={{ fontSize: 20, fontWeight: 'bold', color: '#FFFFFF' }}>浏览器层</Text></Box>
      <Box style={{ width: 970, paddingLeft: 20, justifyContent: 'center' }}><Text style={{ fontSize: 20, color: '#1A2230' }}>Vue 3 + Vite + TypeScript：首页 / 分层教学 / 知识库 / 报错分析，axios 经代理访问 /api</Text></Box>
    </Box>
    <Box style={{ width: 1160, height: 16, alignItems: 'center' }}><Text style={{ fontSize: 14, color: '#3D7BD9' }}>▼　HTTP / JSON</Text></Box>
    <Box style={{ width: 1160, height: 66, flexDirection: 'row', border: '1px solid #3D7BD9' }}>
      <Box style={{ width: 190, background: '#1E4FA8', alignItems: 'center', justifyContent: 'center' }}><Text style={{ fontSize: 20, fontWeight: 'bold', color: '#FFFFFF' }}>接口层</Text></Box>
      <Box style={{ width: 970, paddingLeft: 20, justifyContent: 'center' }}><Text style={{ fontSize: 20, color: '#1A2230' }}>FastAPI：/api/health、/api/teaching/*、/api/library/*、/api/errors/*，Pydantic 契约 + OpenAPI</Text></Box>
    </Box>
    <Box style={{ width: 1160, height: 16, alignItems: 'center' }}><Text style={{ fontSize: 14, color: '#3D7BD9' }}>▼</Text></Box>
    <Box style={{ width: 1160, height: 66, flexDirection: 'row', border: '1px solid #3D7BD9' }}>
      <Box style={{ width: 190, background: '#1E4FA8', alignItems: 'center', justifyContent: 'center' }}><Text style={{ fontSize: 20, fontWeight: 'bold', color: '#FFFFFF' }}>应用层</Text></Box>
      <Box style={{ width: 970, paddingLeft: 20, justifyContent: 'center' }}><Text style={{ fontSize: 20, color: '#1A2230' }}>组合检索 retrieval/　｜　分类·分层·护栏 teaching/　｜　OCR 与分析 errors/（复用同一链路）</Text></Box>
    </Box>
    <Box style={{ width: 1160, height: 16, alignItems: 'center' }}><Text style={{ fontSize: 14, color: '#3D7BD9' }}>▼</Text></Box>
    <Box style={{ width: 1160, height: 66, flexDirection: 'row', border: '1px solid #3D7BD9' }}>
      <Box style={{ width: 190, background: '#1E4FA8', alignItems: 'center', justifyContent: 'center' }}><Text style={{ fontSize: 20, fontWeight: 'bold', color: '#FFFFFF' }}>支撑层</Text></Box>
      <Box style={{ width: 970, paddingLeft: 20, justifyContent: 'center' }}><Text style={{ fontSize: 20, color: '#1A2230' }}>解析·分块·哈希向量·Chroma 索引　｜　OpenAI 兼容客户端　｜　配置与环境变量</Text></Box>
    </Box>
    <Box style={{ width: 1160, height: 76, background: '#E8EFF8', paddingLeft: 22, paddingTop: 10, flexDirection: 'column', gap: 6 }}>
      <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E4FA8' }}>核心数据流</Text>
      <Text style={{ fontSize: 20, color: '#1A2230', lineHeight: 1.4 }}>提问 → 检索 → 六类分类 → 层级钳制 → 引用绑定 → 受约束润色 → 输出侧护栏 → 响应</Text>
    </Box>
    <Box style={{ width: 1160, height: 52, borderLeft: '4px solid #1E4FA8', paddingLeft: 20, justifyContent: 'center' }}>
      <Text style={{ fontSize: 20, color: '#1A2230' }}>教学引擎不自己检索：结果由调用方显式传入 TeachingRequest.retrieval，因此可替换、可单测。</Text>
    </Box>
  </Box>
  <Box style={{ position: 'absolute', top: 670, left: 60, width: 1160, height: 24, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 14, color: '#8B97A8' }}>知实 AI（EduRAG）· 决赛答辩</Text>
    <Text style={{ fontSize: 14, color: '#8B97A8' }}>04 / 13</Text>
  </Box>
</Slide>
