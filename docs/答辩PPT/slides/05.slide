<Slide style={{ width: 1280, height: 720, padding: 0, background: '#FFFFFF', fontFamily: 'Source Han Sans SC, Microsoft YaHei, Arial, sans-serif' }}>
  <Box style={{ width: 1280, height: 68, background: '#1E4FA8', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 60, paddingRight: 60 }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#FFFFFF' }}>为什么不用现成 RAG 框架</Text>
    <Text style={{ fontSize: 16, color: '#C9DBF5' }}>04 · AI STACK</Text>
  </Box>
  <Box style={{ width: 1280, height: 1, background: '#D6DCE5' }} />
  <Box style={{ width: 1280, height: 581, paddingLeft: 60, paddingRight: 60, paddingTop: 24, paddingBottom: 18, flexDirection: 'column', gap: 12 }}>
    <Box style={{ width: 1160, height: 44, background: '#1E4FA8', flexDirection: 'row', alignItems: 'center' }}>
      <Box style={{ width: 200, paddingLeft: 14 }}><Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>技术点</Text></Box>
      <Box style={{ width: 640, paddingLeft: 14 }}><Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>选择与理由</Text></Box>
      <Box style={{ width: 320, paddingLeft: 14 }}><Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>放弃的方案</Text></Box>
    </Box>
    <Box style={{ width: 1160, height: 72, flexDirection: 'row', borderBottom: '1px solid #D6DCE5', alignItems: 'center' }}>
      <Box style={{ width: 200, paddingLeft: 14 }}><Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E4FA8' }}>RAG 框架</Text></Box>
      <Box style={{ width: 640, paddingLeft: 14 }}><Text style={{ fontSize: 18, color: '#1A2230', lineHeight: 1.45 }}>自建链路约 200 行：引用绑定与分层策略需要精确控制，也便于单测与教学展示</Text></Box>
      <Box style={{ width: 320, paddingLeft: 14 }}><Text style={{ fontSize: 18, color: '#4A5568', lineHeight: 1.45 }}>LangChain：抽象层厚，定制护栏更绕</Text></Box>
    </Box>
    <Box style={{ width: 1160, height: 72, flexDirection: 'row', borderBottom: '1px solid #D6DCE5', alignItems: 'center' }}>
      <Box style={{ width: 200, paddingLeft: 14 }}><Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E4FA8' }}>向量化</Text></Box>
      <Box style={{ width: 640, paddingLeft: 14 }}><Text style={{ fontSize: 18, color: '#1A2230', lineHeight: 1.45 }}>512 维离线哈希向量：纯 CPU、零网络请求，无 GPU 与外网也能稳定演示</Text></Box>
      <Box style={{ width: 320, paddingLeft: 14 }}><Text style={{ fontSize: 18, color: '#4A5568', lineHeight: 1.45 }}>语义 Embedding：需 API 或本地模型</Text></Box>
    </Box>
    <Box style={{ width: 1160, height: 72, flexDirection: 'row', borderBottom: '1px solid #D6DCE5', alignItems: 'center' }}>
      <Box style={{ width: 200, paddingLeft: 14 }}><Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E4FA8' }}>向量库</Text></Box>
      <Box style={{ width: 640, paddingLeft: 14 }}><Text style={{ fontSize: 18, color: '#1A2230', lineHeight: 1.45 }}>Chroma 持久化：嵌入式、无需独立服务，索引直接落盘，符合 10 分钟复现</Text></Box>
      <Box style={{ width: 320, paddingLeft: 14 }}><Text style={{ fontSize: 18, color: '#4A5568', lineHeight: 1.45 }}>Qdrant：需额外服务进程</Text></Box>
    </Box>
    <Box style={{ width: 1160, height: 72, flexDirection: 'row', borderBottom: '1px solid #D6DCE5', alignItems: 'center' }}>
      <Box style={{ width: 200, paddingLeft: 14 }}><Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E4FA8' }}>排序</Text></Box>
      <Box style={{ width: 640, paddingLeft: 14 }}><Text style={{ fontSize: 18, color: '#1A2230', lineHeight: 1.45 }}>0.75 余弦 + 0.25 字面覆盖率：缓解中文近义表达不足，两路分数可直接解释</Text></Box>
      <Box style={{ width: 320, paddingLeft: 14 }}><Text style={{ fontSize: 18, color: '#4A5568', lineHeight: 1.45 }}>纯向量排序：专业术语容易漂移</Text></Box>
    </Box>
    <Box style={{ width: 1160, height: 72, flexDirection: 'row', borderBottom: '1px solid #D6DCE5', alignItems: 'center' }}>
      <Box style={{ width: 200, paddingLeft: 14 }}><Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E4FA8' }}>模型接入</Text></Box>
      <Box style={{ width: 640, paddingLeft: 14 }}><Text style={{ fontSize: 18, color: '#1A2230', lineHeight: 1.45 }}>OpenAI 兼容最小公共子集：换供应商只改三个环境变量，不依赖私有 SDK</Text></Box>
      <Box style={{ width: 320, paddingLeft: 14 }}><Text style={{ fontSize: 18, color: '#4A5568', lineHeight: 1.45 }}>厂商 SDK：锁定供应商、增依赖</Text></Box>
    </Box>
    <Box style={{ width: 1160, height: 62, background: '#E8EFF8', borderLeft: '4px solid #D9534F', paddingLeft: 22, justifyContent: 'center' }}>
      <Text style={{ fontSize: 19, color: '#1A2230', lineHeight: 1.4 }}>诚实说明：哈希向量是词面相似度，不是语义向量；这是「离线可复现优先」的取舍，不宣称语义检索效果。</Text>
    </Box>
  </Box>
  <Box style={{ position: 'absolute', top: 670, left: 60, width: 1160, height: 24, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 14, color: '#8B97A8' }}>知实 AI（EduRAG）· 决赛答辩</Text>
    <Text style={{ fontSize: 14, color: '#8B97A8' }}>05 / 13</Text>
  </Box>
</Slide>
